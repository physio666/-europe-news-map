{
  "name": "europe-news-map",
  "version": "0.1.0",
  "private": true,
  "description": "覆盖 46 个欧洲国家/地区的每日新闻热点地图：点选国家查看当日 Top 3 热点新闻，支持 NewsData.io/GDELT/聚合数据真实新闻与 Mock 自动兜底。Next.js 14 App Router + TypeScript + Tailwind + shadcn/ui + react-simple-maps",
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev.mts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/clean.mts",
    "geo:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-geo.mts",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify.mts",
    "check:providers": "node --import ./scripts/loader/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-providers.mts",
    "check:juhe": "node --import ./scripts/loader/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-juhe.mts",
    "check:newsdata": "node --import ./scripts/loader/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-newsdata.mts",
    "check:gdelt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-gdelt.mts",
    "check:browser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/browser-check.mts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "0.454.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-simple-maps": "3.0.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-simple-maps": "3.0.6",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "topojson-client": "3.1.0",
    "typescript": "5.6.3",
    "world-atlas": "2.0.2"
  }
}
