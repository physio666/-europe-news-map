# dependencies
/node_modules

# next.js
/.next/
/.next-dev/
/.next-dev*/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env（只有模板 .env.example 会被提交，其余一律忽略）
.env
.env*.local

# Vercel CLI 的本地项目关联（`vercel link` 生成，含 projectId，不该提交）
.vercel

# 沙箱内安装用的本地缓存（不提交）
.tmp-npm/

# 浏览器验收产生的临时 profile（截图会保留）
/artifacts/.chrome-profile/
/artifacts/.probe-profile/

.vercel
.env*
