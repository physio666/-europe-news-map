# 数据源开关：mock（默认，零外网依赖） | newsdata（NewsData.io，需 Key，支持按国家查询）
#            | juhe（聚合数据，需要 Key） | gdelt（GDELT DOC 2.0，无需 Key）
NEWS_PROVIDER=mock

# ── NewsData.io（newsdata）──────────────────────────────────────────────────
# 免费层 200 credits/天、每请求 1 credit、单次最多返回 10 条；支持 country（alpha-2 小写）
# 与 language，覆盖范围比聚合数据广（小国也可能有数据）。
# API Key 只放服务端：代码从 process.env.NEWSDATA_API_KEY 读取，不硬编码、不打印、不下发到浏览器。
NEWSDATA_API_KEY=your_newsdata_api_key_here

# 切换到 NewsData.io（把上面的 NEWS_PROVIDER 也改成 newsdata）：
# NEWS_PROVIDER=newsdata

# 以下都是 newsdata 模式的可选调优项，不填就用括号里的默认值
# 接口端点（默认 https://newsdata.io/api/1/news）
# NEWSDATA_API_BASE=

# 分类（默认 top 头条；留空则不传 category）
# NEWSDATA_CATEGORY=top

# 每次向上游要多少条（默认 10，免费层上限就是 10；我们只取前 3 条）
# NEWSDATA_SIZE=10

# 单次请求 socket 超时（默认 12000ms）
# NEWSDATA_TIMEOUT_MS=12000

# 全局最小请求间隔（默认 1000ms；额度比聚合数据宽松，不必太严格）
# NEWSDATA_MIN_INTERVAL_MS=1000

# per-country 结果缓存 TTL：key = 国家|日期（默认 3600000ms = 1 小时，这是省 credit 的关键）
# NEWSDATA_CACHE_TTL_MS=3600000

# 当日上游调用上限保护（免费层 200 credits/天，默认留满额 200）
# NEWSDATA_DAILY_LIMIT=200

# 上游刚失败后的短路时长，避免把额度浪费在必失的请求上（默认 60000ms）
# NEWSDATA_FAILURE_COOLDOWN_MS=60000

# ── 聚合数据（juhe）──────────────────────────────────────────────────────────
# 新闻头条 AppKey。免费额度约 50 次/天；务必只放服务端，不要提交到仓库、不要下发到浏览器。
JUHE_NEWS_KEY=

# 接口端点与分类（type=guoji 为国际新闻；该接口不支持按国家查询，只返回新闻池）
# JUHE_API_BASE=https://v.juhe.cn/toutiao/index
# JUHE_NEWS_TYPE=guoji

# 分页（page 最大 50，page_size 最大 30）
# JUHE_PAGE=1
# JUHE_PAGE_SIZE=30

# is_filter：是否只返回有内容详情的新闻（0/1，需求默认 0）
# JUHE_IS_FILTER=0

# 单次请求超时
# JUHE_TIMEOUT_MS=10000

# 全局最小请求间隔（免费额度有限，默认 3 秒）
# JUHE_MIN_INTERVAL_MS=3000

# 新闻池缓存 TTL：所有国家共享同一次上游调用 —— 这是省额度的关键
# JUHE_POOL_TTL_MS=3600000

# 一次取数最多翻几页去找目标国家（1=只用第 1 页；2=没命中时再翻一页）
# JUHE_MAX_PAGES=2

# 当日上游调用上限保护（免费额度 50，默认留 5 次余量）
# JUHE_DAILY_LIMIT=45

# ── 以下都是 GDELT 模式的可选调优项，不填就用括号里的默认值 ──────────────────
# GDELT 查询端点（默认 https://api.gdeltproject.org/api/v2/doc/doc）
# GDELT_API_BASE=

# 单次请求的 socket 超时（默认 15000ms；实测到 GDELT 的连接经常 >10s，所以别调太小）
# GDELT_TIMEOUT_MS=15000

# 一次取数的总预算，超了直接回退 Mock（默认 45000ms）
# GDELT_TOTAL_BUDGET_MS=45000

# 两次上游调用之间的最小间隔，GDELT 要求「每 5 秒最多 1 次」（默认 5200ms）
# GDELT_MIN_INTERVAL_MS=5200

# 同一策略的最大重试次数（默认 3）
# GDELT_MAX_ATTEMPTS=3
